// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  azureId   String   @unique // Azure AD Object ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posters   Poster[]
  playlists Playlist[]
  userTags  UserTag[]

  @@map("users")
}

model Poster {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  year      Int
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags      PosterTag[]
  playlists PlaylistPoster[]

  @@index([userId])
  @@index([title])
  @@index([year])
  @@map("posters")
}

model Playlist {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags    PlaylistTag[]
  posters PlaylistPoster[]

  @@index([userId])
  @@map("playlists")
}

model PredefinedTag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  posterTags   PosterTag[]
  playlistTags PlaylistTag[]

  @@map("predefined_tags")
}

model UserTag {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  posterTags   PosterTag[]
  playlistTags PlaylistTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("user_tags")
}

model PosterTag {
  id              Int     @id @default(autoincrement())
  posterId        Int
  predefinedTagId Int?
  userTagId       Int?

  poster        Poster         @relation(fields: [posterId], references: [id], onDelete: Cascade)
  predefinedTag PredefinedTag? @relation(fields: [predefinedTagId], references: [id], onDelete: Cascade)
  userTag       UserTag?       @relation(fields: [userTagId], references: [id], onDelete: Cascade)

  @@unique([posterId, predefinedTagId, userTagId])
  @@index([posterId])
  @@map("poster_tags")
}

model PlaylistTag {
  id              Int     @id @default(autoincrement())
  playlistId      Int
  predefinedTagId Int?
  userTagId       Int?

  playlist      Playlist       @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  predefinedTag PredefinedTag? @relation(fields: [predefinedTagId], references: [id], onDelete: Cascade)
  userTag       UserTag?       @relation(fields: [userTagId], references: [id], onDelete: Cascade)

  @@unique([playlistId, predefinedTagId, userTagId])
  @@index([playlistId])
  @@map("playlist_tags")
}

model PlaylistPoster {
  id         Int @id @default(autoincrement())
  playlistId Int
  posterId   Int

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  poster   Poster   @relation(fields: [posterId], references: [id], onDelete: Cascade)

  @@unique([playlistId, posterId])
  @@index([playlistId])
  @@index([posterId])
  @@map("playlist_posters")
}
